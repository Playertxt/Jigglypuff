{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "outDir": "../internal/web/dist/js",
    "rootDir": "src",
    "sourceMap": false,
    "removeComments": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
